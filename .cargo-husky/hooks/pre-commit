#!/usr/bin/env bash
#
# csift pre-commit gate - installed by cargo-husky (user-hooks feature) into
# .git/hooks/pre-commit on the first `cargo test` / `cargo build` after checkout.
# Mirrors the CI gate exactly. DO NOT edit the copy in .git/hooks; edit this
# source file (.cargo-husky/hooks/pre-commit) and re-run `cargo test` to reinstall.
#
# Bypass for a genuine WIP commit only: `git commit --no-verify`.
set -euo pipefail

# -- Structure gate (hard limits; Markdown is exempt) --------------------------
# 1. No .rs file over 600 lines (sweet spot 200-400).
# 2. No folder with more than 20 .rs files. A path-named module root (`name.rs`
#    with a sibling `name/` dir) belongs to its directory and does not count
#    against the parent folder.
# 3. No folder with more than 16 direct subfolders: a flat architecture is the
#    design, and what this cap holds back is nesting sprawl, which the depth rule
#    below guards from the other side.
# A CAP THAT BINDS IS A REFACTOR GATE. Re-manage the layout - group a family
# under a path-named root, split a file along a seam that means something. Never
# raise a cap, never squeeze a file in, never force a merge that reads wrong.
# 4. No more than 5 subfolder levels below src/ or tests/ (those roots count 0).
# 5. No `mod.rs` anywhere: module roots are path-named (`src/<m>.rs` beside
#    `src/<m>/`). Clippy's `mod_module_files` enforces the same rule in-build.
# 6. A non-ASCII character in a .rs comment only as a QUOTATION of csift's own
#    rendering: an allowlisted glyph inside a backtick span (`child ⇨ self`,
#    `SUBAGENT <hex>  ·  parent SESSION <uuid>`, a lone role glyph `▹`). Used
#    for the comment's own typography or its logic instead, one character carries
#    a quotation in one line and an arrow in the next, and nothing in the
#    character says which, so those are spelled `->`, `=>`, `<=`, `>=`, `...`,
#    `-`, `section N`, `-- heading --`. The em dash is a printed glyph like any
#    other (an absent instant renders as `—`), so it passes inside a quotation
#    and is reported in prose, by this one rule rather than by a second. A line
#    whose backticks do not BALANCE opens a span that would run to the end of the
#    line, so a comment line with an odd count carrying any non-ASCII character is
#    reported too: an unclosed span is not a quotation. The rule governs
#    COMMENTARY: a doc comment on a clap `#[arg(...)]`/`#[command(...)]` field is
#    the help page's own text, printed verbatim, so there is nothing in it to
#    quote and it is not read.
# Per-function complexity is enforced by clippy (cognitive_complexity, threshold
# in clippy.toml) inside the clippy step below.
echo "[csift pre-commit] structure gate (file/folder limits)"
fail=0
while read -r n f; do
    [ "$f" = "total" ] && continue
    if [ "$n" -gt 600 ]; then
        echo "  OVER 600 LINES: $f ($n) — split it (200-400 is the sweet spot)"
        fail=1
    fi
done < <(find src tests -name '*.rs' -print0 | xargs -0 wc -l)
while read -r n d; do
    if [ "$n" -gt 20 ]; then
        echo "  OVER 20 .rs FILES in $d ($n) — group into subfolders"
        fail=1
    fi
done < <(find src tests -name '*.rs' | while IFS= read -r f; do
    [ -d "${f%.rs}" ] && continue # a paired module root counts with its directory
    dirname "$f"
done | sort | uniq -c | awk '{print $1" "$2}')
while IFS= read -r f; do
    echo "  LEGACY mod.rs: $f - use a path-named module root (name.rs beside name/)"
    fail=1
done < <(find src tests -name mod.rs)
# The glyphs csift itself PRINTS, DERIVED from the source and never typed. TWO
# sources, because a help page reaches the terminal from two shapes: every
# non-ASCII character inside a string or char literal of a non-test file under
# src/ (a render, a banner, a marker, an error string, and the long_about /
# after_help text clap prints), plus every non-ASCII character in a `///` doc
# block on a clap #[arg( / #[command( item, which clap renders verbatim as that
# item's help. To re-derive after a render gains or drops one: lex src/**/*.rs,
# keep the literals of the files outside tests/ and outside an inline
# #[cfg(test)] region (those are test INPUTS and reach no terminal), add the clap
# doc blocks, and collect their non-ASCII characters.
ASCII_ALLOW='·|—|…|→|×|≤|≥|≈|◂|⚠|§|↳|⇒|⇨|─|△|▸|•|–|▹|⚙|↑|↔|⏳|═|▽'
while IFS= read -r hit; do
    echo "  NON-ASCII in a comment: $hit"
    fail=1
done < <(find src tests -name '*.rs' -print0 | LC_ALL=C xargs -0 awk -v ALLOWLIST="$ASCII_ALLOW" '
BEGIN { na = split(ALLOWLIST, allow, "|"); nd = 0 }
FNR == 1 { flushdoc(0) }
{
    t = $0
    sub(/^[ \t]+/, "", t)
    if (t ~ /^\/\/\//) { doc[++nd] = FILENAME SUBSEP FNR SUBSEP t; next }
    if (nd && t == "") { doc[++nd] = ""; next }
    if (nd) flushdoc(t ~ /^#\[arg\(/ || t ~ /^#\[command\(/)
    if (t ~ /^\/\//) { check(FILENAME, FNR, t); next }
    c = trailing($0)
    if (c != "") check(FILENAME, FNR, c)
}
END { flushdoc(0) }
# A doc block is read only once its item is known, because the item decides
# whether the block is commentary or the help page itself.
# What this does NOT read: a /* ... */ block comment, a #[doc = "..."] attribute,
# and a `///` block whose clap attribute is not the first line after it (an
# #[allow(...)] between the two ends the block, so the help doc of that field is
# CHECKED rather than exempted - conservative in the safe direction).
function flushdoc(exempt,   i, p) {
    if (!exempt)
        for (i = 1; i <= nd; i++) {
            if (doc[i] == "") continue
            split(doc[i], p, SUBSEP)
            check(p[1], p[2], p[3])
        }
    nd = 0
    delete doc
}
# The comment a code line carries, "" when it carries none: a double-quoted
# string hides a `//` inside it.
function trailing(s,   i, n, q, c) {
    n = length(s); q = 0
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q) { if (c == "\\") i++; else if (c == "\"") q = 0; continue }
        if (c == "\"") { q = 1; continue }
        if (c == "/" && substr(s, i + 1, 1) == "/") return substr(s, i)
    }
    return ""
}
# Backticks toggle, so part k is inside a span when k is even. Outside one, no
# non-ASCII character at all; inside one, only a glyph csift prints. Stripping
# printable ASCII leaves exactly the bytes to report.
function check(f, ln, txt,   n, parts, i, j, r) {
    n = split(txt, parts, "`")
    if (n % 2 == 0) {
        r = txt
        gsub(/[ -~\t]/, "", r)
        if (r != "") {
            printf "%s:%s carries %s (unbalanced backticks)\n", f, ln, r
            return
        }
    }
    for (i = 1; i <= n; i++) {
        r = parts[i]
        if (i % 2 == 0)
            for (j = 1; j <= na; j++) gsub(allow[j], "", r)
        gsub(/[ -~\t]/, "", r)
        if (r != "")
            printf "%s:%s carries %s %s\n", f, ln, r,
                (i % 2 == 0 ? "(not a glyph csift prints)" : "(outside a backtick span)")
    }
}
' || true)
while IFS= read -r d; do
    n=$(find "$d" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
    if [ "$n" -gt 16 ]; then
        echo "  OVER 16 SUBFOLDERS in $d ($n)"
        fail=1
    fi
done < <(find src tests -type d)
deep=$(find src tests -type d | awk -F/ 'NF>6 {print}')
if [ -n "$deep" ]; then
    echo "  DEEPER THAN 5 LEVELS below src/tests:"
    echo "$deep" | sed 's/^/    /'
    fail=1
fi
if [ "$fail" -ne 0 ]; then
    echo "[csift pre-commit] STRUCTURE GATE FAILED"
    exit 1
fi

echo "[csift pre-commit] cargo fmt --check"
cargo fmt --all -- --check

echo "[csift pre-commit] cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "[csift pre-commit] introspection ledger gate (INTROSPECTION.json backs the README badges)"
# The ledger names every Claude Code behavior csift depends on; the README's
# "verified against Claude Code X" badge is admitted only when EVERY claim's OPEN
# state carries a `verified` receipt at X with claim-specific evidence, every cited
# snippet still exists in its file, and every byte anchor still carries its own
# excerpt in the build it was read in. The rules live in tests/cli/ledger.rs; the
# full `cargo test` below runs it too, this step just fails first and by name.
cargo test --quiet --test cli ledger_gate -- --nocapture 2>&1 | tail -20
if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    echo "[csift pre-commit] LEDGER GATE FAILED (see tests/cli/ledger.rs for the rules)"
    exit 1
fi

echo "[csift pre-commit] cargo test"
cargo test

echo "[csift pre-commit] OK"
